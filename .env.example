# Database (Railway Postgres sẽ inject DATABASE_URL tự động nếu link service)
DATABASE_URL="postgresql://user:password@host:5432/railway?schema=public"

# Auth.js — bắt buộc đổi trên production
AUTH_SECRET="generate-a-long-random-string"
# Đặt bằng URL public sau khi deploy, vd: https://your-app.up.railway.app
AUTH_URL="http://localhost:3000"
# Railway/proxy: trust host (hoặc bật trustHost trong code — đã bật sẵn)
AUTH_TRUST_HOST="true"

# Sapo (tuỳ chọn — cấu hình sau trong /admin/settings/sapo cũng được)
SAPO_STORE_URL="https://your-store.mysapo.net"
SAPO_ACCESS_TOKEN=""
SAPO_WEBHOOK_SECRET=""

# Brand
NEXT_PUBLIC_BRAND_NAME="Tisora"
NEXT_PUBLIC_HOTLINE="19006750"
