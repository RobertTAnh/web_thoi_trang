# Neon / Vercel Postgres
# DATABASE_URL            = pooled (runtime)
# DATABASE_URL_UNPOOLED   = direct (prisma db push / migrate)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Local Docker — đặt cả hai giống nhau:
# DATABASE_URL="postgresql://fashion:fashion@localhost:5433/fashion_shop?schema=public"
# DATABASE_URL_UNPOOLED="postgresql://fashion:fashion@localhost:5433/fashion_shop?schema=public"

# Auth.js — bắt buộc đổi trên production
AUTH_SECRET="generate-a-long-random-string"
# URL public sau deploy, vd: https://tisora-fashion.vercel.app
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Sapo (tuỳ chọn — cấu hình sau trong /admin/settings/sapo cũng được)
SAPO_STORE_URL="https://your-store.mysapo.net"
SAPO_ACCESS_TOKEN=""
SAPO_WEBHOOK_SECRET=""

# Brand
NEXT_PUBLIC_BRAND_NAME="Tisora"
NEXT_PUBLIC_HOTLINE="19006750"
